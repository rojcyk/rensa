{
  "name": "@rojcyk/rensa",
  "version": "0.1.0",
  "description": "Chains of agent steps across the coding CLIs you already pay for.",
  "type": "module",
  "bin": {
    "rensa": "./dist/cli/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run test:e2e"
  },
  "repository": "github:rojcyk/rensa",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "dependencies": {
    "ink": "8.0.0",
    "react": "19.3.1",
    "string-width": "8.3.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "ink-testing-library": "4.0.0",
    "node-pty": "1.1.0",
    "tsdown": "0.23.4",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
